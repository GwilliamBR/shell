{
    "compileOnSave": true,
    "compilerOptions": {
        "target": "ES2022",
        "strict": true,
        "noImplicitAny": true,
        "skipLibCheck": true,
        "outDir": "../../dist/floating_exceptions",
        "rootDir": "./src",
        "forceConsistentCasingInFileNames": true,
        "lib": ["ES2022"],
        "module": "ES2022",
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "pretty": true,
        "removeComments": true,
        "incremental": true,
        "tsBuildInfoFile": "./tsconfig.tsbuildinfo"
    },
    "include": ["src/*.ts"]
}
