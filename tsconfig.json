{
    "version": "1.2.0",
    "compileOnSave": true,
    "compilerOptions": {
        "target": "ES2022",
        "strict": true,
        "noImplicitAny": true,
        "skipLibCheck": true,
        "outDir": "./dist",
        "rootDir": "./src",
        "forceConsistentCasingInFileNames": true,
        "lib": [
            "ES2022"
        ],
        "pretty": true,
        "removeComments": true,
        "incremental": true,
        "tsBuildInfoFile": "./tsconfig.tsbuildinfo",
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "moduleResolution": "NodeNext",
        "module": "NodeNext"
    },
    "include": [
        "src/ambient.d.ts",
        "src/stubs.d.ts",
        "src/*.ts",
        "src/launcher/*.ts"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "tests",
        "src/shortcut_overlay.ts",
        "src/mod.d.ts"
    ]
}
