{
    "compileOnSave": true,
    "compilerOptions": {
        "target": "ES2022",
        "strict": true,
        "noImplicitAny": true,
        "skipLibCheck": true,
        "outDir": "../../dist/color_dialog",
        "rootDir": "./src",
        "forceConsistentCasingInFileNames": true,
        "lib": ["ES2022"],
        "module": "ES2022",
        "pretty": true,
        "removeComments": true,
        "incremental": true,
        "tsBuildInfoFile": "./tsconfig.tsbuildinfo",
        "noUnusedLocals": true,
        "noUnusedParameters": true
    },
    "include": ["src/*.ts"]
}
